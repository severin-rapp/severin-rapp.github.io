plot(log(y_vals), log(R_vals), type = "l", lwd = 2, col = "darkgreen",
xlab = "Income y", ylab = "Return R(I*)",
main = "Return from Optimal Investment vs Income")
grid()
# Add the line for constant-fraction investment
lines(log(y_vals), log(R_const), col = "blue", lwd = 2, lty = 2)
lines(log(y_vals), log( exp(mu + rho * e) *((alpha*rho*0/(1-alpha*(1-rho*0)))* y_vals)^(rho * 0) ), col = "red", lwd = 2, lty = 2)
# Add legend
#legend("topright", legend = c("Optimal I*", "Constant Fraction αy"),
#       col = c("darkgreen", "blue"), lwd = 2, lty = c(1, 2))
# Parameters (you can change these)
# take miles slides.
alpha <- 0.5
#k <- 4
k <- 2
l <- 1.5
mu <-6
e <- log(20000) # endowment in log units
theta <- 0.8 # this and rho should be above unity together
rho <- 0.3 # rho theta product in solon (2014) is 0.3
# (Full vector continued)
y_vals <- seq(1, 20, length.out = 100)
y_vals <- c(
1,2800.00, 3656.42, 4535.52, 5429.68, 6335.19, 7249.87, 8172.24, 9101.24, 10036.09, 10976.15,
11920.98, 12870.20, 13823.50, 14780.61, 15741.29, 16705.36, 17672.62, 18642.92, 19616.12, 20592.10,
21570.74, 22551.94, 23535.61, 24521.65, 25509.97, 26500.49, 27493.14, 28487.83, 29484.51, 30483.10,
31483.55, 32485.79, 33489.77, 34495.43, 35502.73, 36511.62, 37522.06, 38534.02, 39547.44, 40562.31,
41578.58, 42596.22, 43615.20, 44635.49, 45657.06, 46679.88, 47703.93, 48729.19, 49755.62, 50641.67,
51681.35, 52722.27, 53764.41, 54807.74, 55852.23, 56897.84, 57944.55, 58992.33, 60041.14, 61090.96,
62141.75, 63193.48, 64246.12, 65299.64, 66354.01, 67409.20, 68465.19, 69521.93, 70579.41, 71637.60,
72696.46, 73755.98, 74816.11, 75876.83, 76938.12, 77999.94, 79062.27, 80125.08, 81188.33, 82251.99,
83316.04, 84380.45, 85445.18, 86510.21, 87575.51, 88641.04, 89706.78, 90772.70, 91838.76, 92166.38,
96010.68, 99880.04, 103776.59, 107702.64, 111660.71, 115653.49, 119683.91, 123755.06, 127870.24, 132032.95,
136246.98, 140516.31, 144845.25, 149238.36, 153700.50, 158236.84, 162852.93, 167554.64, 172348.26, 170428.76,
186060.29, 202891.78, 220978.22, 240378.49, 261155.57, 283376.77, 307114.10, 332444.69, 359451.39, 1581166.38,1000000
)
bar_y_dot <- quantile(y_vals,0.75)  # assume normalized for simplicity
bar_y_dot <- mean(y_vals)  # assume normalized for simplicity
# Define the utility function to maximize
utility <- function(I, y, mode='own') {
if (I <= 0 || I >= y) return(-Inf)  # ensure feasibility
c <- y - I
R <- exp(mu + rho * e) * I^(rho * theta)
u_c <- (1 - alpha) * (c)^(1 - k) / (1 - k)
#u_log <- alpha * (R - bar_y_dot)^(1 - l) / (1 - l)
if(mode=='own'){u_log <- alpha * (R/y)^(1 - l) / (1 - l)*0.5}
else if (mode=='fixed'){u_log <- alpha * (R/bar_y_dot)^(1 - l) / (1 - l)*0.5}
#u_log <- alpha * (R / bar_y_dot)^-2
#u_log <- alpha * log(R / bar_y_dot)
u_inv <- alpha * R^(1 - k) / (1 - k)*0.5
return(u_c + u_log+u_inv)
}
# Vector of income values
I_opt <- numeric(length(y_vals))
# Use optimize() to maximize utility for each income level
for (i in seq_along(y_vals)) {
y <- y_vals[i]
result <- optimize(f = utility, interval = c(1e-5, y - 1e-5), maximum = TRUE, y = y,mode='fixed')
I_opt[i] <- result$maximum
}
# Plot the result
plot(y_vals, I_opt, type = "l", lwd = 2, col = "blue",
xlab = "Income y", ylab = "Optimal Investment I*(y)",
main = "Optimal Investment as a Function of Income (no rootSolve)")
abline(a = 0, b = 1, lty = 2, col = "gray")  # 45-degree line
legend("topleft", legend = c("I*(y)", "Income = Investment"),
col = c("blue", "gray"), lty = c(1, 2), bty = "n")
grid()
# Compute investment return R(I) = exp(mu + rho * e) * I^(rho * theta)
R_vals <- exp(mu + rho * e) * I_opt^(rho * theta)
# Compute returns when investment is a constant fraction of income
#I_const <- exp(mu+theta*rho*log(alpha*rho*theta/(1-alpha*(1-rho*theta))) + rho*theta*log(y_vals) + rho*e)
I_const <- (alpha*rho*theta/(1-alpha*(1-rho*theta)))* y_vals
R_const <-  exp(mu + rho * e) * I_const^(rho * theta) # replace with your R(I) function
# Plot the original R(I) vs y
plot(log(y_vals), log(R_vals), type = "l", lwd = 2, col = "darkgreen",
xlab = "Income y", ylab = "Return R(I*)",
main = "Return from Optimal Investment vs Income")
grid()
# Add the line for constant-fraction investment
lines(log(y_vals), log(R_const), col = "blue", lwd = 2, lty = 2)
lines(log(y_vals), log( exp(mu + rho * e) *((alpha*rho*0/(1-alpha*(1-rho*0)))* y_vals)^(rho * 0) ), col = "red", lwd = 2, lty = 2)
