bar_y_dot <- quantile(y_vals,0.75)  # assume normalized for simplicity
bar_y_dot <- mean(y_vals)  # assume normalized for simplicity
# Define the utility function to maximize
utility <- function(I, y, mode='own') {
if (I <= 0 || I >= y) return(-Inf)  # ensure feasibility
c <- y - I
R <- exp(mu + rho * e) * I^(rho * theta)
u_c <- (1 - alpha) * (c)^(1 - k) / (1 - k)
#u_log <- alpha * (R - bar_y_dot)^(1 - l) / (1 - l)
if(mode=='own'){u_log <- alpha * (R/y)^(1 - l) / (1 - l)*0.9}
else if (mode=='fixed'){u_log <- alpha * (R/bar_y_dot)^(1 - l) / (1 - l)*0.9}
#u_log <- alpha * (R / bar_y_dot)^-2
#u_log <- alpha * log(R / bar_y_dot)
u_inv <- alpha * R^(1 - k) / (1 - k)*0.1
return(u_c + u_log+u_inv)
}
# Define the utility function to maximize
utility <- function(I, y, mode='own') {
if (I <= 0 || I >= y) return(-Inf)  # ensure feasibility
c <- y - I
R <- exp(mu + rho * e) * I^(rho * theta)
u_c <- (1 - alpha) * (c)^(1 - k) / (1 - k)
#u_log <- alpha * (R - bar_y_dot)^(1 - l) / (1 - l)
u_log <- alpha * (R/bar_y_dot)^(1 - l) / (1 - l)*0.9
#u_log <- alpha * (R / bar_y_dot)^-2
#u_log <- alpha * log(R / bar_y_dot)
u_inv <- alpha * R^(1 - k) / (1 - k)*0.1
return(u_c + u_log+u_inv)
}
# Vector of income values
I_opt <- numeric(length(y_vals))
# Use optimize() to maximize utility for each income level
for (i in seq_along(y_vals)) {
y <- y_vals[i]
result <- optimize(f = utility, interval = c(1e-5, y - 1e-5), maximum = TRUE, y = y,mode='own')
I_opt[i] <- result$maximum
}
# Plot the result
plot(y_vals, I_opt, type = "l", lwd = 2, col = "blue",
xlab = "Income y", ylab = "Optimal Investment I*(y)",
main = "Optimal Investment as a Function of Income (no rootSolve)")
abline(a = 0, b = 1, lty = 2, col = "gray")  # 45-degree line
legend("topleft", legend = c("I*(y)", "Income = Investment"),
col = c("blue", "gray"), lty = c(1, 2), bty = "n")
grid()
# Compute investment return R(I) = exp(mu + rho * e) * I^(rho * theta)
R_vals <- exp(mu + rho * e) * I_opt^(rho * theta)
# Compute returns when investment is a constant fraction of income
#I_const <- exp(mu+theta*rho*log(alpha*rho*theta/(1-alpha*(1-rho*theta))) + rho*theta*log(y_vals) + rho*e)
I_const <- (alpha*rho*theta/(1-alpha*(1-rho*theta)))* y_vals
R_const <-  exp(mu + rho * e) * I_const^(rho * theta) # replace with your R(I) function
# Plot the original R(I) vs y
plot(log(y_vals), log(R_vals), type = "l", lwd = 2, col = "darkgreen",
xlab = "Income y", ylab = "Return R(I*)",
main = "Return from Optimal Investment vs Income")
grid()
# Add the line for constant-fraction investment
lines(log(y_vals), log(R_const), col = "blue", lwd = 2, lty = 2)
